{
	"name": "pls",
	"description": "Prolog Language Server",
	"author": "Martim Vidiera",
	"license": "MIT",
	"version": "0.0.1",
	"publisher": "MartimVideira",
	"repository": {
		"type": "git",
		"url": "https://github.com/MartimVideira/pls"
	},
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages",
		"Linters",
		"Snippets",
		"Formatters",
		"Other"
	],
	"keywords": [
		"prolog",
		"pls",
		"lsp"
	],
	"activationEvents": [
		"onLanguage:prolog"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands":[
			{
				"command":"pls.restartServer",
				"title":"Restart PLS"
			}
		],
		"configuration": {
			"type": "object",
			"title": "pls",
			"properties": {
				"pls.executablePath": {
					"scope": "machine",
					"type": "string",
					"default": "",
					"description": "Specifies an absolute path to the pls executable. If empty pls is expected to be in $PATH variable. (example: /home/user/pls/env/bin/pls)"
				},
				"pls.passes.naming_conventions": {
					"type": "boolean",
					"default": true,
					"description": "Enable naming conventions analysis"
				},
				"pls.passes.single_element_list_append": {
					"type": "boolean",
					"default": true,
					"description": "Enable single element list append analysis"
				},
				"pls.passes.empty_list_append": {
					"type": "boolean",
					"default": true,
					"description": "Enable empty list append analysis"
				},
				"pls.passes.nested_list_constructs": {
					"type": "boolean",
					"default": true,
					"description": "Enable nested list constructs analysis"
				},
				"pls.passes.explicit_unification": {
					"type": "boolean",
					"default": true,
					"description": "Enable explicit unification analysis"
				},
				"pls.passes.wrapper_predicates": {
					"type": "boolean",
					"default": true,
					"description": "Enable wrapper predicates analysis"
				},
				"pls.passes.is_use": {
					"type": "boolean",
					"default": true,
					"description": "Enable is/2 usage analysis"
				},
				"pls.passes.line_length": {
					"type": "boolean",
					"default": false,
					"description": "Enable line length analysis"
				},
				"pls.passes.indentation_consistency": {
					"type": "boolean",
					"default": false,
					"description": "Enable indentation consistency analysis"
				},
				"pls.passes.argument_list": {
					"type": "boolean",
					"default": false,
					"description": "Enable argument list formatting analysis"
				},
				"pls.passes.too_many_arguments": {
					"type": "boolean",
					"default": false,
					"description": "Enable too many arguments analysis"
				},
				"pls.passes.arg_pldoc": {
					"type": "boolean",
					"default": true,
					"description": "Enable argument pldoc comments analysis"
				},
				"pls.passes.clause_length": {
					"type": "boolean",
					"default": false,
					"description": "Enable clause length analysis"
				},
				"pls.passes.subgoal_per_line": {
					"type": "boolean",
					"default": true,
					"description": "Enable subgoal per line analysis"
				},
				"pls.passes.clause_head_length": {
					"type": "boolean",
					"default": false,
					"description": "Enable clause head length analysis"
				},
				"pls.passes.indentation": {
					"type": "string",
					"default": "spaces",
					"description": "Specifies the indentation style to be used. Can be either 'spaces' or 'tabs'."
				},
				"pls.passes.indentation_size": {
					"type": "number",
					"default": 4,
					"description": "Specifies the number of spaces or tabs to be used for indentation."
				},
				"pls.passes.max_line_length": {
					"type": "number",
					"default": 80,
					"description": "Specifies the maximum number of characters allowed per line."
				},
				"pls.passes.max_clause_length": {
					"type": "number",
					"default": 24,
					"description": "Specifies the maximum number of lines allowed per clause."
				},
				"pls.passes.arg_limit": {
					"type": "number",
					"default": 8,
					"description": "Specifies the maximum number of arguments allowed per predicate."
				}
			}
		},
		"configurationDefaults": {
			"[prolog]": {
				"editor.tabSize": 4,
				"editor.insertSpaces": false,
				"editor.detectIndentation": false,
	            "editor.semanticHighlighting.enabled": true

			}
		},
		"languages": [
			{
				"id": "prolog",
				"extensions": [
					".pl"
				],
				"aliases": [
					"prolog",
					"sicstus",
					"swipl",
					"swi",
					"pl"
				],
				"configuration": "./language/config.json"
			}
		],
		"grammars": [
			{
				"language": "prolog",
				"scopeName": "source.prolog",
				"path": "./language/prolog.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^20",
		"@types/vscode": "^1.75.1",
		"@vscode/test-electron": "^2.3.9",
		"esbuild": "^0.25.2",
		"eslint": "^9.13.0",
		"glob": "^11.0.0",
		"mocha": "^10.3.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0",
		"vscode-languageclient": "^9.0.1"
	}
}
